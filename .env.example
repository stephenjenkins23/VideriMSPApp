# VFI configuration template. Copy to .env and fill in.
# NEVER commit a filled-in .env — it is gitignored for a reason.

# ── Videri platform credentials (REQUIRED) ───────────────────────────────
# config.ts requires all three together; the token endpoint needs them.
VIDERI_TENANT=YOURTENANT
VIDERI_USERNAME=you@example.com
VIDERI_PASSWORD=
VIDERI_API_KEY=
# Override only to point at a non-production Videri host.
VIDERI_API_BASE=https://api.go.videri.com

# ── Database (REQUIRED) ──────────────────────────────────────────────────
# Apply src/db/schema.sql first, then src/db/migrations/002..008 in order.
DATABASE_URL=postgres://user:pass@host:5432/vfi

# ── Read API ─────────────────────────────────────────────────────────────
# VFI_API_TOKEN is REQUIRED unless the server is started with
# --allow-anonymous. Minimum 16 characters; the server refuses to start on a
# missing or short token. --allow-anonymous exposes the whole read API and is
# for local development ONLY.
VFI_API_TOKEN=
VFI_API_PORT=8080
# NOTE the container gotcha: this defaults to 127.0.0.1, which inside a
# container is unreachable from outside it. In Docker/k8s set 0.0.0.0.
VFI_API_HOST=127.0.0.1
# Comma-separated origins for the dashboard. Empty = same-origin only.
VFI_API_CORS_ORIGINS=

# ── Poll cadences (defaults are measured, not guessed — see config.ts) ───
# POLL_STATUS_INTERVAL_MS=120000
# POLL_METRICS_INTERVAL_MS=420000
# POLL_DEVICE_BATCH_SIZE=100

# ── Opt-in lanes. Each issues per-device commands, so each is a decision. ─
ENABLE_TELEMETRY_SLOWLANE=true    # CPU/RAM/storage/RSSI/NTP, 15 min, batch 10
ENABLE_SCHEDULE_SLOWLANE=true     # publisher schedules -> proof of play, 30 min
ENABLE_SCREEN_VERIFY=true         # verifies black-screen claims, 15 min
# ENABLE_SETTINGS_POLL=true       # ops_get_settings, hourly, online-only
# ENABLE_DATA_USAGE_POLL=false    # enabled by default; set false to disable

# ── AI artifacts (PAID Claude calls — off by default, on purpose) ─────────
# Brief daily, action plan every 8h. Requires ANTHROPIC_API_KEY.
# ENABLE_AI_JOBS=true
ANTHROPIC_API_KEY=
